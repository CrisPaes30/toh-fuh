# ===== FIREBASE FRONTEND =====
# Obtenha estes valores no Firebase Console > Project Settings
VITE_FIREBASE_API_KEY="AIzaSyD..."
VITE_FIREBASE_AUTH_DOMAIN="to-fuhh-xxxxx.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="to-fuhh-xxxxx"
VITE_FIREBASE_STORAGE_BUCKET="to-fuhh-xxxxx.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# ===== FIREBASE BACKEND (Admin SDK) =====
# Copie TODO o conteúdo do arquivo JSON do Admin SDK como uma única linha
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"to-fuhh-xxxxx",...}'

# ===== ANALYTICS (Opcional - deixe em branco se não usar) =====
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_IUX=""
VITE_ANALYTICS_WEBSITE_ID=""

# ===== APP BRANDING =====
VITE_APP_TITLE="To Fuhh"
VITE_APP_LOGO="/logo.png"
VITE_APP_ID="to-fuhh"

# ===== DESENVOLVIMENTO =====
NODE_ENV="development"
